%% The AMSCesena palette, recovered from CesenaSMA2006 (Beamer's orchid and
%% whale over its default blue): each colour carries its provenance beside it.
%% Roles and contrasts: README.md.

\mode<presentation>

%% base colours
\definecolor{owblue}{HTML}{3333B2}         % beamer@blendedblue, the 2006 structure
\definecolor{owbluedeep}{HTML}{262686}     % structure!75!black, whale secondary, orchid block title
\definecolor{owbluedark}{HTML}{1A1A59}     % structure!50!black, whale tertiary
\definecolor{owbluelight}{HTML}{C2C2E8}    % structure!30!white, guessed: the light blue
\definecolor{owbluetint}{HTML}{E9E9F3}     % orchid block body, block title!10!white
\definecolor{owbluepale}{HTML}{EBEBF7}     % structure!10, whale sidebar primary
\definecolor{owbluemid}{HTML}{9999D9}      % structure!50, whale sidebar tertiary
\definecolor{owred}{HTML}{FF0000}          % red, Beamer's alerted text
\definecolor{owreddeep}{HTML}{BF0000}      % red!75!black, orchid alerted block title
\definecolor{owredfill}{HTML}{F9E6E6}      % orchid alerted block body
\definecolor{owgreen}{HTML}{008000}        % green!50!black, Beamer's example text
\definecolor{owgreendeep}{HTML}{006000}    % example text!75!black, orchid example block title
\definecolor{owgreenfill}{HTML}{E6EFE6}    % orchid example block body
\definecolor{owblack}{HTML}{000000}        % black, whale quaternary
\definecolor{owtext}{HTML}{000000}         % black, Beamer's normal text
\definecolor{owgrey}{HTML}{404040}         % darkgray, guessed: institute
\definecolor{owgreymid}{HTML}{5A5A5A}      % gray!70!black, guessed: secondary text
\definecolor{owgreyline}{HTML}{BFBFBF}     % lightgray, guessed: \ccite, \uuurl
\definecolor{owgreybg}{HTML}{ECECEC}       % gray!15!white, guessed: \cccite
\definecolor{owwhite}{HTML}{FFFFFF}
\definecolor{basecolour}{HTML}{3333B2} % blue

%% blue is the identity colour, deep blue the structural one
\setbeamercolor{structure}{fg=owblue}
\setbeamercolor{section in toc}{fg=owbluedeep,bg=owwhite}
\setbeamercolor{alerted text}{fg=owred}
\setbeamercolor{example text}{fg=owgreen}

%% palettes, whale's: blue to black
\setbeamercolor*{palette primary}{fg=owwhite,bg=owblue}
\setbeamercolor*{palette secondary}{fg=owwhite,bg=owbluedeep}
\setbeamercolor*{palette tertiary}{fg=owwhite,bg=owbluedark}
\setbeamercolor*{palette quaternary}{fg=owwhite,bg=owblack}

\setbeamercolor*{sidebar}{bg=owblue}
\setbeamercolor*{palette sidebar primary}{fg=owbluepale}
\setbeamercolor*{palette sidebar secondary}{fg=owwhite}
\setbeamercolor*{palette sidebar tertiary}{fg=owbluemid}
\setbeamercolor*{palette sidebar quaternary}{fg=owwhite}

%% title and frame title -- the title in whale's blue box, frame titles blue on white
\setbeamercolor{titlelike}{parent=palette primary}
\setbeamercolor{frametitle}{fg=owblue,bg=owwhite}
\setbeamercolor{frametitle right}{bg=owwhite}

%% rules
\setbeamercolor*{separation line}{fg=owbluelight}
\setbeamercolor*{fine separation line}{fg=owgreyline}

\mode
<all>
